# Supabase — Settings -> API no painel do projeto
# A chave publishable nasce para viver no bundle do navegador; quem protege os
# dados e o RLS, nao o segredo dela.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Identificacao exigida pela politica de uso do Nominatim (busca de destino).
# Use um contato real no .env local e nas variaveis da Vercel — mas NAO commite
# e-mail pessoal aqui: este arquivo e publico.
VITE_NOMINATIM_APP=Konvo/0.1 (contato@seu-dominio.com)
